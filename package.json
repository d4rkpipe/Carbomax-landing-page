{
  "name": "carbomax-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev:all": "concurrently -n web,api -c cyan,green \"vite\" \"API_PORT=3001 node --env-file-if-exists=.env server/index.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "seed": "node --env-file-if-exists=.env server/prisma/seed.js",
    "seed:demo": "SEED_DEMO=1 node --env-file-if-exists=.env server/prisma/seed.js",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-imask": "^7.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.0",
    "prisma": "^7.8.0",
    "vite": "^5.4.10"
  }
}
