# Nusxa oling: `cp .env.example .env`, keyin qiymatlarni to'ldiring.
# .env commit qilinmaydi (.gitignore'da). Server avtomatik o'qiydi.

# ── Telegram bildirishnomalari ──────────────────────────────────────────────
# Forma to'ldirilganda murojaat shu Telegram guruh/chatga yuboriladi.
# Bo'sh qoldirsangiz — murojaat baribir DB'ga saqlanadi, faqat Telegram yo'q.
#   1) @BotFather'da /newbot → token oling
#   2) Guruh oching, botni qo'shing
#   3) chat_id ni oling (guruh id'lari manfiy son, masalan -1001234567890)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Admin (seed uchun) ───────────────────────────────────────────────────────
# O'zgartirgandan keyin `npm run seed` ishlating (yangi admin yaratiladi).
ADMIN_USER=admin
ADMIN_PASS=carbomax2026

# ── Xavfsizlik ───────────────────────────────────────────────────────────────
# Production'da albatta uzun, tasodifiy qiymatga o'zgartiring.
JWT_SECRET=carbomax-dev-secret-change-in-production
